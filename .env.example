# Copy to .env and fill in. Never commit .env.
PORT=3000
# Votes needed to settle an answer (set to 1 to test alone, 3 for the demo)
MIN_VOTES=3
# Earners within this many miles of a place get its requests (nearest first)
ANSWER_RADIUS_MILES=5
# Place search prefers results near this point (lat,lng). Default: ASU Tempe
GEO_BIAS=33.4242,-111.9281
# Optional: a Discord invite link, shown as a second QR
DISCORD_INVITE_URL=
# Public address of this server (your domain on Vultr). Used in photo links.
PUBLIC_URL=http://localhost:3000
# Optional: require this key on /api/ask (the MCP server sends it)
ORACLE_API_KEY=

# MongoDB Atlas: Connect -> Drivers -> connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=oracle

# Tiger Data: service -> Connect -> connection string
TIGER_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Discord: Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click server icon -> Copy Server ID (Developer Mode on)
DISCORD_GUILD_ID=
# Right-click #oracle -> Copy Channel ID
DISCORD_CHANNEL_ID=

# Telegram: @BotFather -> /newbot
TELEGRAM_TOKEN=

# Gemini: aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=

# TinyFish: agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Solana devnet treasury: run `npm run wallet`, paste the secret here, fund it at faucet.solana.com
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_TREASURY_SECRET=
REWARD_VOTE_SOL=0.001
REWARD_PHOTO_SOL=0.01
# Cash-out rate and minimum (points)
POINTS_PER_SOL=1000
MIN_CASHOUT=10
