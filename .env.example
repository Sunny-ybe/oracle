# Copy to .env and fill in. Never commit .env.
PORT=3000
# Votes needed to settle an answer (set to 1 to test alone, 3 for the demo)
MIN_VOTES=3
# Earners within this many miles of a place get its requests (nearest first)
ANSWER_RADIUS_MILES=5
# Place search prefers results near this point (lat,lng). Default: ASU Tempe
GEO_BIAS=33.4242,-111.9281
# Optional: a Discord invite link, shown as a second QR
DISCORD_INVITE_URL=
# Public address of this server (your domain on Vultr). Used in photo links.
PUBLIC_URL=http://localhost:3000
# Fixed public link for `npm run demo` (scripts/start.sh rewrites PUBLIC_URL). Best first:
#   Cloudflare named tunnel: TUNNEL_TOKEN + PUBLIC_DOMAIN (e.g. oracle.tryalethea.com)
#   ngrok fixed domain:      NGROK_DOMAIN (e.g. name.ngrok-free.dev)
# Leave all empty for a quick tunnel whose address changes every run.
TUNNEL_TOKEN=
PUBLIC_DOMAIN=
NGROK_DOMAIN=
# Optional: require this key on /api/ask (the MCP server sends it)
ORACLE_API_KEY=
# Signs app sign-ins. Must be the SAME on every laptop/server (use the TELEGRAM_TOKEN value so old sign-ins keep working)
SESSION_SECRET=

# MongoDB Atlas: Connect -> Drivers -> connection string
MONGODB_URI=mongodb://localhost:27017/oracle
MONGODB_DB=oracle

# Tiger Data: service -> Connect -> connection string
TIGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Discord: Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click server icon -> Copy Server ID (Developer Mode on)
DISCORD_GUILD_ID=
# Right-click #oracle -> Copy Channel ID
DISCORD_CHANNEL_ID=

# Telegram: @BotFather -> /newbot
TELEGRAM_TOKEN=

# Gemini: aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=

# TinyFish reads the official pages of the campus places (hours, schedules, menus) in the background.
# Optional: without it, official-page answers are off. agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Solana devnet treasury: run `npm run wallet`, paste the secret here, fund it at faucet.solana.com
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_TREASURY_SECRET=
REWARD_VOTE_SOL=0.001
REWARD_PHOTO_SOL=0.01
# Cash-out rate and minimum (points)
POINTS_PER_SOL=1000
MIN_CASHOUT=10

# Optional: "Continue with Google" and "Continue with Microsoft" in the Oracle app
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Native iPhone and remote MCP integration
ORACLE_URL=http://localhost:3000
GOOGLE_PLACES_API_KEY=
AUTO_IMPORT_PLACES=1
GOOGLE_IOS_CLIENT_ID=
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.oracleprototype.Oracle

# Amazon Rekognition (optional): finds faces to blur in photos, alongside Gemini
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional worldwide place-search provider (Nominatim-compatible). Default: public OSM service.
# Searches are explicit, cached and throttled. Use a dedicated provider for larger deployments.
PLACE_SEARCH_URL=https://nominatim.openstreetmap.org/search
CACHE_MINUTES=0
